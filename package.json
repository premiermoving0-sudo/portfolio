    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^11.18.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
